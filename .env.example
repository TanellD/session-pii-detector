# Скопируй в .env и заполни. .env не коммитится.
HF_TOKEN=
OPENAI_API_KEY=
# Radeon Cloud: ключ только локально, не отправлять в чат.
RADEON_API_KEY=
# Необязательный ключ собственного OpenAI-compatible сервера.
LLM_API_KEY=
ANTHROPIC_API_KEY=
DADATA_API_KEY=
# Пользовательский токен VK API; доступ к users.search проверяется отдельно.
VK_ACCESS_TOKEN=
VK_SERVICE_TOKEN=
VK_API_VERSION=5.199
# Публичное Web-приложение VK ID; ID не является секретом.
VK_CLIENT_ID=
VK_REDIRECT_URI=http://localhost/callback
# Следующие значения локальный помощник авторизации запишет в .env автоматически.
VK_REFRESH_TOKEN=
VK_DEVICE_ID=
VK_TOKEN_SCOPE=
VK_TOKEN_EXPIRES_AT=
VK_TOKEN_OBTAINED_AT=
# Одноклассники: права приложения VALUABLE_ACCESS и GROUP_CONTENT.
OK_APPLICATION_ID=
OK_APPLICATION_KEY=
OK_APPLICATION_SECRET_KEY=
OK_ACCESS_TOKEN=
# Числовой ID выбранной группы; не токен.
OK_GROUP_ID=

# Сервис: regex по умолчанию, stub для пустого каркаса, gliner для локальной модели.
PII_DETECTOR_MODE=regex
# Для gliner: каталог уже подготовленной модели с manifest.json; без скачиваний.
PII_MODEL_DIR=

# Docker v2: base|v2; внешний линкер выключен для начального замера.
PII_ADAPTER_REVISION=v2
PII_LINKER_MODE=bypass
# error: HTTP 502 без коммита состояния; unknown: продолжить с неполнотой.
PII_LINKER_FALLBACK=error
PII_LINKER_TIMEOUT_SECONDS=90
PII_LINKER_CONCURRENCY=1
PII_BENCHMARK_LINKER_DELAY_MS=0
PII_MAX_INFLIGHT=32
PII_TORCH_THREADS=2
PII_LOG_SAMPLE_RATE=1
# Пустое значение для локального запуска: используется базовая политика.
# Для Compose настройте путь ВНУТРИ контейнера, например /app/configs/runtime-risk-tuned-validation.json.
# PII_RISK_POLICY=
